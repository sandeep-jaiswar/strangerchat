{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "strangerchat.vercel.app"
        }
      ],
      "destination": "https://funstranger.in/$1",
      "permanent": true
    }
  ]
}
