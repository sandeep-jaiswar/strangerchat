# Public URL of this app.
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared with apps/realtime. Generate with: openssl rand -base64 32
REALTIME_JWT_SECRET=
# Chat server URL. In production use wss://, e.g. wss://<your-fly-app>.fly.dev.
# Baked in at build time: rebuild the web app after changing it.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4000

# Google AdSense. Leave empty to show placeholders in development.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
