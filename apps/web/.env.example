# Public URL of this app.
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis for chat matchmaking. On Vercel, add Redis from the Marketplace (Storage tab);
# it sets REDIS_URL for you. Locally: docker run -d -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379

# Development only: the chat socket is served by the dev server in packages/chat-server,
# because Vercel's WebSocket support only exists on Vercel. Leave unset in production.
NEXT_PUBLIC_WS_URL=ws://localhost:3001/api/ws

# Google AdSense. Leave empty to show placeholders in development.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# SEO. Canonical public origin (defaults to https://Strangerchat.vercel.app) and
# ownership tokens from Google Search Console / Bing Webmaster Tools.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
