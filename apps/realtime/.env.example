# Local development: copy to .env. On Fly.io, set REALTIME_JWT_SECRET and
# ALLOWED_ORIGINS with `fly secrets set` instead; PORT comes from fly.toml.

# Port the server listens on. Must match internal_port in fly.toml (8080) in production.
PORT=4000

# Must match REALTIME_JWT_SECRET in apps/web exactly, and be at least 32 characters.
# Generate with: openssl rand -base64 32 (use a different value in production).
REALTIME_JWT_SECRET=

# Comma-separated origins allowed to open a socket: scheme + host, no trailing slash.
# Production example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000
