{
  "extends": "@funstranger/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictNullChecks": true,
    "paths": {
      "@funstranger/ui/*": [
        "./src/*"
      ]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
