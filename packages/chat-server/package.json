    "next-auth": "^4.24.15",
    "obscenity": "^0.4.6",
    "posthog-node": "^5.68.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@funstranger/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "@types/ws": "^8.18.1",
    "typescript": "7.0.2"
  }
