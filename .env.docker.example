# Copy to .env on your Oracle Cloud server before running:
#   docker compose up -d --build

# Domain served by Caddy. Use ":80" for raw-IP HTTP testing, or your domain for auto-HTTPS.
SITE_DOMAIN=funstranger.in
WWW_REDIRECT_SITE=www.funstranger.in
ACME_EMAIL=you@gmail.com
# Optional host IP to bind ports 80/443 (useful if Tailscale uses :443 on tailscale0)
HOST_BIND_IP=0.0.0.0

# Public site URL (must match SITE_DOMAIN with https:// in production)
NEXT_PUBLIC_SITE_URL=https://funstranger.in
NEXTAUTH_URL=https://funstranger.in

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_random_32_byte_base64_secret

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: https://funstranger.in/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL (Docker service on the Oracle VM)
POSTGRES_USER=strangerchat
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=strangerchat

# Redis prefix
CHAT_REDIS_PREFIX=sc:

# Google AdSense (set before building Docker image; Next.js inlines NEXT_PUBLIC_* at build time)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-3834685478743012
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# Search engine verification tokens (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
INDEXNOW_KEY=3e2f6e540f92b5b78001f37dd4bd261a

# PostHog product analytics (EU Cloud default: https://eu.i.posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
